#!/bin/bash
# Global say queue entry point. Usage: claude-say "text" [voice_override] [session_id]
# Per-session queue prevents voice from one Claude window leaking into another.
# Voice routing is handled by the daemon (single multilingual voice handles LT + EN).

TEXT="$1"
VOICE_OVERRIDE="$2"
SESSION="${3:-${CLAUDE_SESSION_ID:-default}}"

[ -z "$TEXT" ] && exit 0

# Global voice on/off switch. Single choke point: every TTS request flows through
# here, so one flag silences all sessions. Missing file = enabled (fail-on).
# Toggle from anywhere with the `voicetoggle` terminal command.
VOICE_STATE_FILE="$HOME/.claude/voice-pipeline/voice.state"
if [ "$(cat "$VOICE_STATE_FILE" 2>/dev/null)" = "off" ]; then
  printf '%s [%s] %s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "${3:-default}" "muted" "(voice off, dropped chars=${#TEXT})" \
    >> "$HOME/.claude/voice-pipeline/voice.log" 2>/dev/null
  exit 0
fi

QUEUE_ROOT="/tmp/claude-say-queue"
QUEUE_DIR="$QUEUE_ROOT/$SESSION"
MESSAGES_DIR="$QUEUE_DIR/messages"
LOCKDIR="$QUEUE_DIR/daemon.lock"
PIDFILE="$QUEUE_DIR/daemon.pid"

mkdir -p "$MESSAGES_DIR"

LOG_FILE="$HOME/.claude/voice-pipeline/voice.log"
log_event() {
  printf '%s [%s] %s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "${SESSION:0:8}" "$1" "${2:-}" >> "$LOG_FILE" 2>/dev/null
}

# Filename: <microsecond_ts>__<voice_override_or_empty>.msg
TS=$(python3 -c 'import time; print(int(time.time()*1000000))')
printf '%s' "$TEXT" > "$MESSAGES_DIR/${TS}__${VOICE_OVERRIDE}.msg"
log_event "queued" "ts=$TS chars=${#TEXT}"

# Start daemon for this session if not already running.
# Liveness is determined by the daemon's PID, not lockdir age. A slow Google TTS
# request (--max-time 25) can legitimately exceed any short age threshold, so we
# only consider the lock stale when the recorded PID is no longer alive.
if [ -d "$LOCKDIR" ]; then
  alive=0
  if [ -f "$PIDFILE" ]; then
    pid=$(cat "$PIDFILE" 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      alive=1
    fi
  fi
  if [ "$alive" -eq 0 ]; then
    log_event "lock-stale-cleanup" "pidfile=$(cat "$PIDFILE" 2>/dev/null)"
    rm -rf "$LOCKDIR"
    rm -f "$PIDFILE"
  fi
fi

if mkdir "$LOCKDIR" 2>/dev/null; then
  log_event "daemon-start" ""
  ( bash ~/.claude/voice-pipeline/claude-say-daemon.sh "$QUEUE_DIR" </dev/null >/dev/null 2>&1 & )
fi

exit 0
