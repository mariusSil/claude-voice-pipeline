#!/bin/bash
# Global say queue entry point. Usage: claude-say "text" [voice_override] [session_id]
# Per-session queue prevents voice from one Claude window leaking into another.
# Voice routing is handled by the daemon (single multilingual voice handles LT + EN).

TEXT="$1"
VOICE_OVERRIDE="$2"
SESSION="${3:-${CLAUDE_SESSION_ID:-default}}"

[ -z "$TEXT" ] && exit 0

QUEUE_ROOT="/tmp/claude-say-queue"
QUEUE_DIR="$QUEUE_ROOT/$SESSION"
MESSAGES_DIR="$QUEUE_DIR/messages"
LOCKDIR="$QUEUE_DIR/daemon.lock"

mkdir -p "$MESSAGES_DIR"

# Filename: <microsecond_ts>__<voice_override_or_empty>.msg
TS=$(python3 -c 'import time; print(int(time.time()*1000000))')
printf '%s' "$TEXT" > "$MESSAGES_DIR/${TS}__${VOICE_OVERRIDE}.msg"

# Start daemon for this session if not already running.
if [ -d "$LOCKDIR" ]; then
  age=$(($(date +%s) - $(stat -f %m "$LOCKDIR" 2>/dev/null || echo 0)))
  [ "$age" -gt 15 ] && rm -rf "$LOCKDIR"
fi

if mkdir "$LOCKDIR" 2>/dev/null; then
  ( bash ~/.claude/voice-pipeline/claude-say-daemon.sh "$QUEUE_DIR" </dev/null >/dev/null 2>&1 & )
fi

exit 0
